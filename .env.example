# Copy this file to .env.local and fill it in.

# The n8n webhook of workflow 17 (DentalFlow · 17 Web Chat), production URL.
# Example: https://condone-making-amount.ngrok-free.dev/webhook/web-chat
# Leave empty to run the chat in DEMO MODE (scripted answers, nothing is booked).
N8N_WEB_CHAT_URL=

# The secret value of the "DentalFlow web key" Header Auth credential in n8n
# (header name X-DentalFlow-Web-Key). It stays on the server: the browser never sees it.
N8N_WEB_CHAT_KEY=
